# Google Gemini API Key for Multimodal Extraction & Vector Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=text-embedding-004

# PostgreSQL + pgvector Connection (Supabase URI)
# Format: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Video processing limits (Step 4)
MAX_DIRECT_VIDEO_DURATION_SEC=180
MAX_DIRECT_VIDEO_SIZE_MB=50
